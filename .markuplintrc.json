{
  "parser": {
    ".tsx": "@markuplint/jsx-parser"
  },
  "specs": {
    ".tsx": "@markuplint/react-spec"
  },
  "rules": {
    "no-unknown-attr": true,
    "no-disallowed-attr": true,
    "no-invalid-attr-value": true,
    "no-event-handler-attr": false,
    "require-attr": true,
    "no-aria-on-unsupported-element": true,
    "no-unknown-role": true,
    "no-abstract-role": true,
    "require-parent-role": true,
    "require-aria-prop": true,
    "no-deprecated-role": true,
    "no-redundant-role": true,
    "permitted-roles": true,
    "no-prohibited-naming": true,
    "element-supports-aria-prop": true,
    "role-supports-aria-prop": true,
    "no-deprecated-aria-prop": true,
    "no-redundant-aria-prop": true,
    "no-contradictory-aria-prop": true,
    "no-invalid-aria-prop-value": true,
    "no-default-aria-value": true,
    "aria-prop-requires-role": true,
    "require-owned-elements": false,
    "no-aria-on-presentational-children": true,
    "no-focusable-in-aria-hidden": true,
    "tab-requires-tabpanel": true,
    "no-nested-top-level-landmark": true,
    "require-landmark-label": true,
    "require-h1": true,
    "no-duplicate-h1": true,
    "no-pseudo-list": true,
    "no-empty-palpable-content": false
  },
  "overrides": {
    "**/*.stories.tsx": {
      "rules": {
        "no-aria-on-unsupported-element": false,
        "no-unknown-role": false,
        "no-abstract-role": false,
        "require-parent-role": false,
        "require-aria-prop": false,
        "no-deprecated-role": false,
        "no-redundant-role": false,
        "permitted-roles": false,
        "no-prohibited-naming": false,
        "element-supports-aria-prop": false,
        "role-supports-aria-prop": false,
        "no-deprecated-aria-prop": false,
        "no-redundant-aria-prop": false,
        "no-contradictory-aria-prop": false,
        "no-invalid-aria-prop-value": false,
        "no-default-aria-value": false,
        "aria-prop-requires-role": false,
        "no-aria-on-presentational-children": false,
        "no-focusable-in-aria-hidden": false,
        "tab-requires-tabpanel": false,
        "no-nested-top-level-landmark": false,
        "require-landmark-label": false,
        "require-h1": false,
        "no-duplicate-h1": false,
        "no-pseudo-list": false
      }
    }
  }
}
