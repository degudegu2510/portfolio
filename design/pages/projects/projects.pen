                    },
                    {
                      "id": "miohR",
                      "type": "ref",
                      "ref": "ds:O0JhwX",
                      "name": "Paragraph",
                      "width": "fill_container",
                      "descendants": {
                        "ds:bXG7z": {
                          "content": "一方で、既存の色にはアクセシビリティの課題がありました。Qiita のブランドカラーである緑（#55C500）は、上に白い文字を乗せるとコントラスト比が 2.24 しかなく、基準を満たせません。しかし、黒い文字を乗せるとブランドガイドラインに反してしまいます。"
                        }
                      }
                    },
                    {
                      "id": "nAQCp",
